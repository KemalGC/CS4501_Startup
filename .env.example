# Local defaults. Export these variables; the app does not auto-load this file.
PROOFGRADE_HINT_MODE=demo
PROOFGRADE_TEACHER_AI=disabled
PROOFGRADE_TEACHER_DB=data/teachers.sqlite3
# Set true behind HTTPS; leave false only for local HTTP development.
PROOFGRADE_SECURE_COOKIES=false
PROOFGRADE_STORE_ATTEMPTS=false
PROOFGRADE_DB_PATH=data/proofgrade.sqlite3
# Required only for enabled OpenAI modes. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=
# Vision + Structured Outputs model; falls back to OPENAI_MODEL when empty.
PROOFGRADE_VISION_MODEL=
