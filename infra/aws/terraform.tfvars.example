# Public configuration only. NEVER place the Google client secret in this file.
# If copied to terraform.tfvars, that file is excluded by .gitignore.

aws_region  = "us-east-1"
environment = "aws-dev"

allowed_origins = [
  "https://strokesense-aws-dev.vercel.app",
  "http://localhost:8000",
  "http://localhost:3000",
  "http://localhost:5173",
]

cognito_callback_urls = [
  "https://strokesense-aws-dev.vercel.app/demos/",
  "http://localhost:8000/demos/",
  "http://localhost:3000/demos/",
  "http://localhost:5173/demos/",
]

cognito_logout_urls = [
  "https://strokesense-aws-dev.vercel.app/",
  "http://localhost:8000/",
  "http://localhost:3000/",
  "http://localhost:5173/",
]

# Must not contain aws, amazon or cognito (Cognito reserved words).
cognito_domain_prefix = "strokesense-dev"

# -1 = unreserved. Restore 10 / 1 after the account Lambda concurrency quota is raised.
api_reserved_concurrency       = -1
reconcile_reserved_concurrency = -1

free_lifetime_bytes      = 300000000
free_max_video_bytes     = 100000000
paid_max_video_bytes     = 750000000
cpu_max_vcpus            = 10 # Five concurrent 2-vCPU workers, subject to Fargate quota
cpu_global_daily_limit   = 5
cpu_global_monthly_limit = 50
enable_cpu_analysis      = false # Public analysis stays off until reviewed guardrails + AWS apply
# One-job operator smoke test only; restore max 10 for approved public beta:
# cpu_max_vcpus        = 2
# worker_image_tag     = "smoke-20261119023607" # Smoke-tested tag; ECR tags can be overwritten, review digest too
# enable_cpu_smoke_queue = true  # API submissions stay disabled
monthly_budget_usd       = 30
daily_budget_usd         = 3

# Sensitive: enable admin ONLY after verifying the Google-linked Cognito sub
# and manually adding that user to the strokesense-admin user pool group.
# admin_cognito_subs = ["actual-cognito-sub-not-email"]
admin_audit_retention_days   = 90
terminal_job_record_grace_days = 7

# REQUIRED: configure a real inbox before `terraform plan` / `terraform apply`.
# Prefer `TF_VAR_alert_email` in your shell rather than committing an address:
# export TF_VAR_alert_email='you@example.com'
# AWS Budgets sends direct email; SNS operational alerts separately require
# the recipient to confirm an email subscription.
# google_oauth_client_id is safe to expose in a web client, but Terraform treats
# it as sensitive along with the private google_oauth_client_secret. Supply both
# through environment variables, not committed .tfvars files.
