# GPU prototype, does not launch AWS compute or enable paid billing.
# Supply an operator-reviewed CUDA 12.x / cuDNN 9 image PINNED BY SHA256 digest, e.g.
#   docker build --platform linux/amd64 -f Dockerfile.aws-gpu \
#     --build-arg CUDA_BASE_IMAGE=nvidia/cuda@sha256:<digest> -t strokesense-aws-gpu:gpu-smoke-<ts> .
# from the strokesense/ directory.
ARG CUDA_BASE_IMAGE
FROM ${CUDA_BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 MPLCONFIGDIR=/tmp/strokesense-mpl HOME=/tmp PYTHONPATH=/app PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg libgomp1 libglib2.0-0 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY requirements-aws-gpu.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements-aws-gpu.txt
# Fail the build if the CPU-only runtime slipped in (it would shadow the CUDA
# build of the onnxruntime module) or if this ONNX Runtime lacks the CUDA EP.
RUN if python3 -m pip show onnxruntime >/dev/null 2>&1; then echo "CPU onnxruntime must not be installed" >&2; exit 1; fi \
    && python3 -c "import onnxruntime as ort; p = ort.get_available_providers(); print('ONNX Runtime', ort.__version__, p); assert ort.get_device() == 'GPU' and 'CUDAExecutionProvider' in p, p"
COPY strokesense/ ./strokesense/
COPY aws_app/ ./aws_app/
RUN python3 -c "from strokesense.pose import ensure_model; from aws_app.gpu_model_integrity import verify_gpu_model; p = ensure_model(); verify_gpu_model(p)" && chmod -R a+rX /app/models
USER 10001:10001
# Confirm the non-root worker can read and re-verify the pinned weights.
RUN python3 -c "from strokesense.pose import ensure_model; from aws_app.gpu_model_integrity import verify_gpu_model; verify_gpu_model(ensure_model()); print('GPU model verified for worker user')"
# Worker fails closed until ECS injects STROKESENSE_PAID_GPU_WORKER_ENABLED=true
CMD ["python3", "-m", "aws_app.gpu_worker"]
